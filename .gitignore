dumps/
outputs/
chain_dbs/
dist/
__pycache__/
*.pyc
.DS_Store

# KAN-34 scratch: one-off exploration and intermediate dumps for the
# cheapersal geocode fill. data/branch_addresses.json and
# data/branch_locations.json are the durable outputs; this is working
# state, disposable and too large/messy for git history.
scripts_scratch/

# Service-account keys. Never in the repo - they live in GitHub Actions secrets
# and, locally, outside the working tree entirely.
*-sa.json
*service-account*.json
gha-creds-*.json

# Scraper log, written into the working tree on every local run.
logging.log

# Claude Code local settings - but not .claude/skills/, which is checked in.
.claude/settings.local.json
.claude/launch.json

# KAN-29 name-review TSVs: regenerated from any build in seconds, disposable,
# and too large (tens of MB) to keep in git history. review/README.md stays
# tracked for provenance.
review/*.tsv
# ...except the shorter-names decisions log: a record of human judgement,
# not regenerable output, so it is kept.
!review/shorter_names_decisions.tsv
